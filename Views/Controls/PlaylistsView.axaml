<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:NullWave.ViewModels"
      xmlns:models="using:NullWave.Models"
      xmlns:helpers="using:NullWave.Helpers"
      xmlns:converters="using:NullWave.Helpers.Converters"
      xmlns:material="using:Material.Icons.Avalonia"
      x:Class="NullWave.Views.Controls.PlaylistsView"
      x:DataType="vm:MainViewModel"
      ColumnDefinitions="280,1,*">
    <Grid.Resources>
        <helpers:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <converters:FilePathToBitmapConverter x:Key="PathToBitmap"/>
        <converters:SourceToBackgroundConverter x:Key="SourceToBg"/>
        <converters:TrackIdEqualsConverter x:Key="TrackIdEquals"/>
        <converters:SortFieldDisplayConverter x:Key="SortFieldDisplay"/>
        <converters:BoolToSortIconConverter x:Key="BoolToSortIcon"/>
    </Grid.Resources>
    <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Button Classes="primary"
                    Content="+ New Playlist"
                    Command="{Binding Playlist.CreatePlaylistCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>
        </Border>
        <ListBox ItemsSource="{Binding Playlist.Playlists}"
                 SelectedItem="{Binding Playlist.SelectedPlaylist}"
                 Background="Transparent"
                 Margin="8,8,4,8">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Playlist">
                    <Grid ColumnDefinitions="*,Auto" Margin="6,6">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Tracks.Count, StringFormat='{}{0} tracks'}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeXs}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="icon-btn sm"
                                ToolTip.Tip="Unpin from sidebar"
                                Command="{Binding $parent[ListBox].DataContext.Playlist.UnpinCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding IsPinned}">
                            <material:MaterialIcon Kind="Pin" Width="16" Height="16"/>
                        </Button>
                        <Button Grid.Column="1"
                                Classes="icon-btn sm"
                                ToolTip.Tip="Pin to sidebar"
                                Command="{Binding $parent[ListBox].DataContext.Playlist.PinCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding !IsPinned}">
                            <material:MaterialIcon Kind="PinOutline" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock DockPanel.Dock="Bottom"
                   Text="No playlists yet - create one above"
                   Foreground="{StaticResource BrushTextMuted}"
                   FontSize="{StaticResource FontSizeSm}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="16"
                   IsVisible="{Binding !Playlist.Playlists.Count}"/>
    </DockPanel>
    <Border Grid.Column="1" Background="{StaticResource BrushBorder}"/>
    <DockPanel Grid.Column="2" IsVisible="{Binding Playlist.ShowPlaylistDetail}">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2" IsVisible="{Binding !Playlist.IsRenaming}">
                    <TextBlock Text="{Binding Playlist.SelectedPlaylist.Name}"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Playlist.SelectedPlaylist.Tracks.Count, StringFormat='{}{0} tracks'}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
                <Grid Grid.Column="0" ColumnDefinitions="*,8,Auto,8,Auto"
                      IsVisible="{Binding Playlist.IsRenaming}"
                      VerticalAlignment="Center">
                    <TextBox Grid.Column="0"
                             Text="{Binding Playlist.RenameText, Mode=TwoWay}"/>
                    <Button Grid.Column="2"
                            Classes="primary"
                            Content="Save"
                            Command="{Binding Playlist.ConfirmRenameCommand}"
                            Padding="12,6"/>
                    <Button Grid.Column="4"
                            Classes="secondary"
                            Content="Cancel"
                            Command="{Binding Playlist.CancelRenameCommand}"
                            Padding="12,6"/>
                </Grid>
                <Button Grid.Column="1"
                        Classes="icon-btn"
                        ToolTip.Tip="Rename playlist"
                        Command="{Binding Playlist.StartRenameCommand}"
                        IsVisible="{Binding !Playlist.IsRenaming}"
                        Margin="8,0,0,0">
                    <material:MaterialIcon Kind="Pencil" Width="18" Height="18"/>
                </Button>
                <Button Grid.Column="2"
                        Classes="icon-btn"
                        ToolTip.Tip="Delete playlist"
                        Command="{Binding Playlist.RemovePlaylistCommand}"
                        IsVisible="{Binding !Playlist.IsRenaming}"
                        Margin="4,0,0,0">
                    <material:MaterialIcon Kind="TrashCan" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="*,8,Auto,8,Auto" VerticalAlignment="Center">
                <TextBox Grid.Column="0"
                         Text="{Binding Playlist.SearchQuery, Mode=TwoWay}"
                         PlaceholderText="Search this playlist..."
                         VerticalAlignment="Center">
                    <TextBox.InnerLeftContent>
                        <material:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="8,0,0,0"
                                               Foreground="{StaticResource BrushTextMuted}"/>
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <Button Classes="icon-btn sm"
                                Command="{Binding Playlist.ClearSearchTextCommand}"
                                IsVisible="{Binding Playlist.HasSearchQuery}"
                                ToolTip.Tip="Clear search">
                            <material:MaterialIcon Kind="Close" Width="14" Height="14"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Playlist.SortOptions}"
                          SelectedItem="{Binding Playlist.CurrentSort}"
                          MinWidth="130"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource SortFieldDisplay}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="4"
                        Classes="icon-btn"
                        Command="{Binding Playlist.ToggleSortDirectionCommand}"
                        ToolTip.Tip="Toggle sort direction"
                        VerticalAlignment="Center">
                    <material:MaterialIcon Kind="{Binding Playlist.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                           Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Playlist.ResultCountLabel}"
                   Classes="section-label"
                   FontSize="{StaticResource FontSizeXs}"
                   Margin="16,8,16,0"/>
        <ListBox ItemsSource="{Binding Playlist.FilteredTracks}"
                 Background="Transparent"
                 Margin="8,4,8,8">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid ColumnDefinitions="48,*,150,36" Margin="8,5" MinHeight="44">
                        <Border Grid.Column="0"
                                Width="3"
                                HorizontalAlignment="Left"
                                Margin="-8,-5,0,-5"
                                Background="{StaticResource BrushAccent}"
                                CornerRadius="0,2,2,0">
                            <Border.IsVisible>
                                <MultiBinding Converter="{StaticResource TrackIdEquals}">
                                    <Binding Path="Id"/>
                                    <Binding Path="$parent[ListBox].DataContext.Player.CurrentTrack.Id"/>
                                </MultiBinding>
                            </Border.IsVisible>
                        </Border>
                        <Border Grid.Column="0"
                                Width="40" Height="40"
                                CornerRadius="{StaticResource RadiusArt}"
                                Background="{StaticResource BrushSurface2}"
                                ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Panel>
                                <Image Source="{Binding AlbumArtPath, Converter={StaticResource PathToBitmap}}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding AlbumArtPath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <material:MaterialIcon Kind="MusicNote"
                                                       IsVisible="{Binding AlbumArtPath, Converter={x:Static ObjectConverters.IsNull}}"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       Width="18" Height="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,8,0">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Artist}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2"
                                VerticalAlignment="Center"
                                CornerRadius="{StaticResource RadiusFull}"
                                Padding="10,4"
                                HorizontalAlignment="Left">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding Source, Converter={StaticResource SourceToBg}}"/>
                            </Border.Background>
                            <TextBlock Text="{Binding Source}"
                                       Foreground="White"
                                       FontSize="{StaticResource FontSizeXs}"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Button Grid.Column="3"
                                Classes="icon-btn"
                                ToolTip.Tip="Remove from playlist"
                                Command="{Binding $parent[ListBox].DataContext.Playlist.RemoveFromPlaylistCommand}"
                                CommandParameter="{Binding}"
                                VerticalAlignment="Center">
                            <material:MaterialIcon Kind="Close" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="This playlist is empty - add tracks from the Library page"
                   Foreground="{StaticResource BrushTextMuted}"
                   FontSize="{StaticResource FontSizeSm}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="16"
                   IsVisible="{Binding !Playlist.SelectedPlaylist.Tracks.Count}"/>
        <TextBlock Text="No tracks match your search"
                   Foreground="{StaticResource BrushTextMuted}"
                   FontSize="{StaticResource FontSizeSm}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="16"
                   IsVisible="{Binding !Playlist.FilteredTracks.Count}"/>
    </DockPanel>
    <DockPanel Grid.Column="2" IsVisible="{Binding Playlist.ShowFolderGrid}">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Playlist.SelectedFolder.Name}"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="Bold"/>
                    <TextBlock Text="Folder"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="icon-btn"
                        ToolTip.Tip="Back to playlists"
                        Command="{Binding Playlist.NavigateToFolderCommand}"
                        CommandParameter="{x:Null}">
                    <material:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Playlist.FolderContents}" Margin="16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Playlist">
                        <Button Width="160" Height="180" Margin="8"
                                Background="{StaticResource BrushSurface2}"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="0"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding $parent[ItemsControl].DataContext.Playlist.SelectPlaylistFromFolderCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                <material:MaterialIcon Kind="PlaylistMusic" Width="48" Height="48" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBody}" FontWeight="Medium" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                <TextBlock Text="{Binding Tracks.Count, StringFormat='{}{0} tracks'}" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeXs}" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
    <StackPanel Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                IsVisible="{Binding Playlist.ShowEmptyState}">
        <material:MaterialIcon Kind="MusicNote"
                               Width="48" Height="48"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"/>
        <TextBlock Text="Select a playlist or folder to view its contents"
                   Foreground="{StaticResource BrushTextMuted}"
                   FontSize="{StaticResource FontSizeBody}"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</Grid>